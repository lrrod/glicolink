[
  {
    "id": "tab1",
    "type": "tab",
    "label": "Monitor CGM IoT",
    "disabled": false
  },
  {
    "id": "broker1",
    "type": "mqtt-broker",
    "name": "HiveMQ público",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "",
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "in-glic",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Glicemia (CGM)",
    "topic": "mackenzie/cgm-iot/paciente-1006/glicemia",
    "qos": "1",
    "datatype": "json",
    "broker": "broker1",
    "x": 140,
    "y": 80,
    "wires": [
      [
        "fn-glic"
      ]
    ]
  },
  {
    "id": "in-alerta",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Alertas",
    "topic": "mackenzie/cgm-iot/paciente-1006/alerta",
    "qos": "1",
    "datatype": "json",
    "broker": "broker1",
    "x": 120,
    "y": 180,
    "wires": [
      [
        "fn-alerta"
      ]
    ]
  },
  {
    "id": "in-ins",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Diário de insulina",
    "topic": "mackenzie/cgm-iot/paciente-1006/insulina",
    "qos": "1",
    "datatype": "json",
    "broker": "broker1",
    "x": 150,
    "y": 280,
    "wires": [
      [
        "fn-ins"
      ]
    ]
  },
  {
    "id": "in-ack",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Ack de comando",
    "topic": "mackenzie/cgm-iot/paciente-1006/ack",
    "qos": "1",
    "datatype": "json",
    "broker": "broker1",
    "x": 140,
    "y": 420,
    "wires": [
      [
        "fn-rtt"
      ]
    ]
  },
  {
    "id": "in-status",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Status do nó",
    "topic": "mackenzie/cgm-iot/paciente-1006/status",
    "qos": "1",
    "datatype": "auto",
    "broker": "broker1",
    "x": 130,
    "y": 520,
    "wires": [
      [
        "txt-status"
      ]
    ]
  },
  {
    "id": "fn-glic",
    "type": "function",
    "z": "tab1",
    "name": "extrai mg/dL",
    "func": "msg.payload = msg.payload.glicemia;\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 80,
    "wires": [
      [
        "chart-glic",
        "gauge-glic"
      ]
    ]
  },
  {
    "id": "fn-alerta",
    "type": "function",
    "z": "tab1",
    "name": "formata alerta",
    "func": "const a = msg.payload;\nmsg.payload = `${a.tipo.toUpperCase()} | ${a.glicemia} mg/dL | ${a.msg}`;\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 180,
    "wires": [
      [
        "txt-alerta"
      ]
    ]
  },
  {
    "id": "fn-ins",
    "type": "function",
    "z": "tab1",
    "name": "formata dose",
    "func": "const d = msg.payload;\nmsg.payload = `${d.tipo} ${d.dose_UI} UI (${d.origem}) | glicemia ${d.glicemia} mg/dL`;\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 280,
    "wires": [
      [
        "txt-ins"
      ]
    ]
  },
  {
    "id": "btn-buzzer",
    "type": "ui_button",
    "z": "tab1",
    "name": "Acionar buzzer",
    "group": "grp2",
    "order": 1,
    "width": 6,
    "height": 1,
    "label": "Acionar buzzer (via MQTT)",
    "payload": "",
    "payloadType": "str",
    "topic": "",
    "x": 140,
    "y": 350,
    "wires": [
      [
        "fn-cmd-buzzer"
      ]
    ]
  },
  {
    "id": "btn-led",
    "type": "ui_button",
    "z": "tab1",
    "name": "Acionar LED amarelo",
    "group": "grp2",
    "order": 2,
    "width": 6,
    "height": 1,
    "label": "Acionar LED amarelo (via MQTT)",
    "payload": "",
    "payloadType": "str",
    "topic": "",
    "x": 160,
    "y": 385,
    "wires": [
      [
        "fn-cmd-led"
      ]
    ]
  },
  {
    "id": "fn-cmd-buzzer",
    "type": "function",
    "z": "tab1",
    "name": "monta comando buzzer",
    "func": "const id = (flow.get('seq')||0)+1;\nflow.set('seq', id);\nflow.set('t_cmd_'+id, Date.now());\nmsg.payload = JSON.stringify({id: id, atuador: 'buzzer'});\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 350,
    "wires": [
      [
        "out-cmd"
      ]
    ]
  },
  {
    "id": "fn-cmd-led",
    "type": "function",
    "z": "tab1",
    "name": "monta comando LED",
    "func": "const id = (flow.get('seq')||0)+1;\nflow.set('seq', id);\nflow.set('t_cmd_'+id, Date.now());\nmsg.payload = JSON.stringify({id: id, atuador: 'led_amarelo'});\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 385,
    "wires": [
      [
        "out-cmd"
      ]
    ]
  },
  {
    "id": "out-cmd",
    "type": "mqtt out",
    "z": "tab1",
    "name": "Comando",
    "topic": "mackenzie/cgm-iot/paciente-1006/comando",
    "qos": "1",
    "broker": "broker1",
    "x": 620,
    "y": 367,
    "wires": []
  },
  {
    "id": "fn-rtt",
    "type": "function",
    "z": "tab1",
    "name": "calcula tempo de resposta",
    "func": "const a = msg.payload;\nconst t0 = flow.get('t_cmd_' + a.id);\nif (t0) {\n  const rtt = Date.now() - t0;\n  msg.payload = `${a.atuador}: ${rtt} ms (ida e volta)`;\n} else {\n  msg.payload = `${a.atuador}: ack recebido`;\n}\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 420,
    "wires": [
      [
        "txt-rtt"
      ]
    ]
  },
